#!/bin/sh
#
# pre-push: a push to main runs the package tests and builds the runner. Other branches push freely.
# `swift test` alone never compiles `Runner/` (an Xcode UI-test target outside the package, and half of
# most changes), so the runner is built too. `build-for-testing`, not `test-without-building`: the
# runner's one test is a walk, needing a booted simulator and an app under validation, which a push
# gate cannot have. Bypass once with: git push --no-verify

set -e

cd "$(git rev-parse --show-toplevel)"

pushing_to_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  case "$remote_ref" in
    refs/heads/main) pushing_to_main=1 ;;
  esac
done

if [ "$pushing_to_main" -eq 0 ]; then
  echo "▸ pre-push: not pushing to main — skipping project verification."
  exit 0
fi

echo "▸ pre-push: running project verification on main…"
swift test
xcodebuild build-for-testing -project Runner/SimWalkRunner.xcodeproj -scheme SimWalkRunner -destination 'generic/platform=iOS Simulator' -quiet

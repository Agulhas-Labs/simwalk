#!/bin/sh
#
# pre-commit: staged Swift files under Sources, Tests and Runner must be formatted and lint-clean.

set -e

cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(Sources|Tests|Runner)/.*\.swift$' || true)
if [ -z "$staged" ]; then
  exit 0
fi

command -v swiftformat >/dev/null 2>&1 || { echo "SwiftFormat not installed — run: brew install swiftformat"; exit 1; }
command -v swiftlint   >/dev/null 2>&1 || { echo "SwiftLint not installed — run: brew install swiftlint"; exit 1; }

echo "==== SwiftFormat ===="
# One path per line, so a path with a space stays one argument.
IFS='
'
set -f
# shellcheck disable=SC2086
set -- $staged
set +f
unset IFS

swiftformat "$@" --lint --config .swiftformat

echo "==== SwiftLint ===="
# --force-exclude honours the config's `excluded:` for files named on the command line. SwiftLint exits
# non-zero when that leaves nothing to lint; that is a pass, not a failure.
if ! output=$(swiftlint lint --strict --force-exclude --config .swiftlint.yml "$@" 2>&1); then
  if ! printf '%s\n' "$output" | grep -q 'No lintable files found'; then
    printf '%s\n' "$output"
    echo "Lint violations found. Fix them before committing."
    exit 1
  fi
fi
if [ -n "$output" ]; then
  printf '%s\n' "$output"
fi

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Agent worktrees — Claude Code's per-agent worktrees (Agent tool `isolation: worktree`).
.claude/worktrees/
.claude/handoffs/

# Xcode user state
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Build products
build/
DerivedData/
*.moved-aside
*.hmap
*.dSYM.zip
*.dSYM

# Test results
*.xcresult

# Swift Package Manager
.swiftpm
.build/
# Without the slash as well: in a git worktree a hook may link a tool's build directory to the primary
# checkout's, and a trailing slash matches directories only — so a symlink named `.build` slipped past
# `.build/` and `git add -A` committed a machine-absolute path that is dead in any other checkout.
.build

# Generated by xcode-build-server for SourceKit-LSP editor integration.
buildServer.json

# Capture bundles produced by local walk runs — outputs, never sources.
Captures/

# Logs
*.log
